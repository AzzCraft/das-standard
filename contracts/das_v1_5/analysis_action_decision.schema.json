{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.das.dev/contracts/das-analysis-action-decision/v1",
  "title": "DAS preapproved analysis action decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractIdentity",
    "issuer",
    "audience",
    "decisionId",
    "actor",
    "action",
    "verificationPlanDigest",
    "verificationEvidenceDigest",
    "bindings",
    "authorityEpoch",
    "targetGeneration",
    "targetCandidateDigest",
    "integrationReceiptDigest",
    "notBefore",
    "expiresAt",
    "allow",
    "observationExceptions"
  ],
  "properties": {
    "contractIdentity": {
      "const": "das-analysis-action-decision/v1"
    },
    "issuer": {
      "$ref": "#/$defs/id"
    },
    "audience": {
      "$ref": "#/$defs/id"
    },
    "decisionId": {
      "$ref": "#/$defs/id"
    },
    "actor": {
      "$ref": "#/$defs/id"
    },
    "action": {
      "$ref": "#/$defs/action"
    },
    "verificationPlanDigest": {
      "$ref": "#/$defs/digest"
    },
    "verificationEvidenceDigest": {
      "$ref": "#/$defs/digest"
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "authorityEpoch": {
      "$ref": "#/$defs/integer"
    },
    "targetGeneration": {
      "$ref": "#/$defs/integer"
    },
    "targetCandidateDigest": {
      "$ref": "#/$defs/digest"
    },
    "integrationReceiptDigest": {
      "type": "null"
    },
    "notBefore": {
      "$ref": "#/$defs/time"
    },
    "expiresAt": {
      "$ref": "#/$defs/time"
    },
    "allow": {
      "type": "boolean"
    },
    "observationExceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\u0000]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "action": {
      "enum": [
        "complete",
        "audit"
      ]
    },
    "taskKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityDomain",
        "projectId",
        "changeId",
        "taskId"
      ],
      "properties": {
        "authorityDomain": {
          "$ref": "#/$defs/id"
        },
        "projectId": {
          "$ref": "#/$defs/id"
        },
        "changeId": {
          "$ref": "#/$defs/id"
        },
        "taskId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskKey",
        "taskRevision",
        "taskCycle",
        "resourceId",
        "resourceInstance",
        "targetGeneration",
        "obligationDigest",
        "sourceCandidateDigest",
        "baselineCandidateDigest",
        "policyDigest",
        "toolDigest",
        "standardDigest",
        "bundleDigest",
        "factsDigest",
        "acceptanceDigest",
        "environmentDigest",
        "lineageDigest",
        "completionMode",
        "taskBindingDigest"
      ],
      "properties": {
        "taskKey": {
          "$ref": "#/$defs/taskKey"
        },
        "taskRevision": {
          "$ref": "#/$defs/integer"
        },
        "taskCycle": {
          "$ref": "#/$defs/integer"
        },
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "resourceInstance": {
          "$ref": "#/$defs/id"
        },
        "targetGeneration": {
          "$ref": "#/$defs/integer"
        },
        "obligationDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceCandidateDigest": {
          "$ref": "#/$defs/digest"
        },
        "baselineCandidateDigest": {
          "$ref": "#/$defs/digest"
        },
        "policyDigest": {
          "$ref": "#/$defs/digest"
        },
        "toolDigest": {
          "$ref": "#/$defs/digest"
        },
        "standardDigest": {
          "$ref": "#/$defs/digest"
        },
        "bundleDigest": {
          "$ref": "#/$defs/digest"
        },
        "factsDigest": {
          "$ref": "#/$defs/digest"
        },
        "acceptanceDigest": {
          "$ref": "#/$defs/digest"
        },
        "environmentDigest": {
          "$ref": "#/$defs/digest"
        },
        "lineageDigest": {
          "$ref": "#/$defs/digest"
        },
        "completionMode": {
          "const": "analysis"
        },
        "taskBindingDigest": {
          "$ref": "#/$defs/digest"
        },
        "completionDigest": {
          "$ref": "#/$defs/digest"
        },
        "verificationScopeDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "dependentRequired": {
        "completionDigest": [
          "verificationScopeDigest"
        ],
        "verificationScopeDigest": [
          "completionDigest"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "audit"
          }
        }
      },
      "then": {
        "properties": {
          "bindings": {
            "required": [
              "completionDigest",
              "verificationScopeDigest"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "bindings": {
            "not": {
              "required": [
                "completionDigest"
              ]
            }
          }
        }
      }
    }
  ]
}
