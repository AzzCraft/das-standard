{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.das.dev/contracts/das-analysis-completion/v1",
  "title": "DAS preapproved analysis completion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractIdentity",
    "taskKey",
    "taskRevision",
    "taskCycle",
    "obligationDigest",
    "parentChange",
    "policyDigest",
    "sourceCandidateDigest",
    "resourceId",
    "resourceInstance",
    "targetGeneration",
    "businessActionId",
    "verificationPlanDigest",
    "verificationEvidenceDigest",
    "decisionDigest",
    "completedAt",
    "authorityEpoch",
    "authority",
    "qualification",
    "completionMode",
    "taskBindingDigest",
    "requestDigest"
  ],
  "properties": {
    "contractIdentity": {
      "const": "das-analysis-completion/v1"
    },
    "taskKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityDomain",
        "projectId",
        "changeId",
        "taskId"
      ],
      "properties": {
        "authorityDomain": {
          "$ref": "#/$defs/id"
        },
        "projectId": {
          "$ref": "#/$defs/id"
        },
        "changeId": {
          "$ref": "#/$defs/id"
        },
        "taskId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "taskRevision": {
      "$ref": "#/$defs/positive"
    },
    "taskCycle": {
      "$ref": "#/$defs/positive"
    },
    "obligationDigest": {
      "$ref": "#/$defs/digest"
    },
    "policyDigest": {
      "$ref": "#/$defs/digest"
    },
    "sourceCandidateDigest": {
      "$ref": "#/$defs/digest"
    },
    "resourceId": {
      "$ref": "#/$defs/id"
    },
    "resourceInstance": {
      "$ref": "#/$defs/id"
    },
    "targetGeneration": {
      "$ref": "#/$defs/positive"
    },
    "businessActionId": {
      "$ref": "#/$defs/id"
    },
    "verificationPlanDigest": {
      "$ref": "#/$defs/digest"
    },
    "verificationEvidenceDigest": {
      "$ref": "#/$defs/digest"
    },
    "decisionDigest": {
      "$ref": "#/$defs/digest"
    },
    "completedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "authorityEpoch": {
      "$ref": "#/$defs/positive"
    },
    "authority": {
      "const": false
    },
    "qualification": {
      "const": false
    },
    "parentChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "generation",
        "taskSetDigest"
      ],
      "properties": {
        "status": {
          "enum": [
            "active",
            "closing"
          ]
        },
        "generation": {
          "$ref": "#/$defs/positive"
        },
        "taskSetDigest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        }
      }
    },
    "completionMode": {
      "const": "analysis"
    },
    "taskBindingDigest": {
      "$ref": "#/$defs/digest"
    },
    "requestDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\u0000]+$"
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    }
  }
}
