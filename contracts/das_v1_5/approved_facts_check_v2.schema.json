        "digestMethod": {
          "const": "rfc8785-jcs-utf8-sha256"
        },
        "resolvedModules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "unresolvedModules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "moduleId",
              "state"
            ],
            "properties": {
              "moduleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "state": {
                "enum": [
                  "true",
                  "false",
                  "unknown",
                  "conflict"
                ]
              }
            }
          }
        },
        "factStates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "state",
              "sourceRefs"
            ],
