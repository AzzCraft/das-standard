{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.das.dev/contracts/approved-facts-check/v2",
  "title": "Native supplied-context facts check; no installed authority (versioned complete mapping)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractIdentity",
    "preview",
    "checkedRefs",
    "authority",
    "qualification"
  ],
  "properties": {
    "contractIdentity": {
      "const": "das-approved-facts-check/v2"
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractIdentity",
        "scope",
        "standardVersion",
        "policyDigest",
        "factsDigest",
        "catalogDigest",
        "digestMethod",
        "resolvedModules",
        "unresolvedModules",
        "factStates",
        "ruleTrace",
        "authorityVerified",
        "qualificationEligible",
        "limitations",
        "previewDigest",
        "requirementsCatalogDigest",
        "leafMigrationComplete",
        "requirementTrace"
      ],
      "properties": {
        "contractIdentity": {
          "const": "das-bundle-preview/v3"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "standardVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
