{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "das-candidate-binding/v1",
  "title": "DAS complete committed-tree candidate binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractIdentity", "taskKey", "taskRevision", "taskCycle", "obligationDigest", "policyDigest", "source", "archive", "files", "externalMaterials"],
  "properties": {
    "contractIdentity": {"const": "das-candidate-binding/v1"},
    "taskKey": {
      "type": "object", "additionalProperties": false,
      "required": ["authorityDomain", "projectId", "changeId", "taskId"],
      "properties": {
        "authorityDomain": {"$ref": "#/$defs/id"}, "projectId": {"$ref": "#/$defs/id"},
        "changeId": {"$ref": "#/$defs/id"}, "taskId": {"$ref": "#/$defs/id"}
      }
    },
    "taskRevision": {"$ref": "#/$defs/positive"},
    "taskCycle": {"$ref": "#/$defs/positive"},
    "obligationDigest": {"$ref": "#/$defs/digest"},
    "policyDigest": {"$ref": "#/$defs/digest"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "objectFormat", "commitOid", "treeOid", "commitContentSha256", "view"],
      "properties": {
        "kind": {"const": "git"},
        "objectFormat": {"enum": ["sha1", "sha256"]},
        "commitOid": {"$ref": "#/$defs/oid"}, "treeOid": {"$ref": "#/$defs/oid"},
        "commitContentSha256": {"$ref": "#/$defs/digest"},
        "view": {"const": "complete-committed-tree"}
      }
    },
    "archive": {
      "type": "object", "additionalProperties": false,
      "required": ["encoding", "rawSha256", "decodedSha256"],
      "properties": {
        "encoding": {"enum": ["tar-ustar", "gzip-tar-ustar"]},
        "rawSha256": {"$ref": "#/$defs/digest"}, "decodedSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 2048,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "mode", "size", "blobOid", "contentSha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 240},
          "mode": {"enum": ["100644", "100755"]},
          "size": {"type": "integer", "minimum": 0, "maximum": 16777216},
          "blobOid": {"$ref": "#/$defs/oid"}, "contentSha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "externalMaterials": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["materialId", "role", "size", "contentSha256", "mediaType"],
        "properties": {
          "materialId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$(?![\\s\\S])"},
          "role": {"enum": ["dependency", "model", "prompt", "preprocessing", "build-input"]},
          "size": {"type": "integer", "minimum": 0, "maximum": 16777216},
          "contentSha256": {"$ref": "#/$defs/digest"},
          "mediaType": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$(?![\\s\\S])"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000]+$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"},
    "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$(?![\\s\\S])"}
  }
}
