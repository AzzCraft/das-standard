{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cadence.das.dev/schemas/das-v1.5/http_declaration/v1",
  "title": "DAS reference http declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractIdentity",
    "scope",
    "sourceDirection",
    "rootURI",
    "sources"
  ],
  "properties": {
    "contractIdentity": {
      "const": "das-http-declaration/v1"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sourceDirection": {
      "const": "openapi-first"
    },
    "rootURI": {
      "type": "string",
      "format": "uri",
      "minLength": 1,
      "maxLength": 2048
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "uniqueItems": true
    }
  }
}
