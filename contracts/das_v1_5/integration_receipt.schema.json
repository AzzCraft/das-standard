{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "das-integration-receipt/v1",
  "title": "DAS staging actual integration receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractIdentity",
    "authorityDomain",
    "resourceId",
    "resourceInstance",
    "action",
    "businessActionId",
    "requestDigest",
    "planDigest",
    "beforeCandidateDigest",
    "afterCandidateDigest",
    "beforeGeneration",
    "afterGeneration",
    "rollbackOf",
    "executingActor",
    "authorityEpoch",
    "committedAt",
    "committed",
    "authority",
    "qualification",
    "sourceCandidateDigest",
    "verificationPlanDigest",
    "verificationEvidenceDigest",
    "decisionDigest",
    "taskKey",
    "taskRevision",
    "taskCycle",
    "policyDigest",
    "toolDigest",
    "obligationDigest"
  ],
  "properties": {
    "contractIdentity": {
      "const": "das-integration-receipt/v1"
    },
    "authorityDomain": {
      "$ref": "#/$defs/id"
    },
    "resourceId": {
      "$ref": "#/$defs/id"
    },
    "resourceInstance": {
      "$ref": "#/$defs/id"
    },
    "action": {
      "const": "integrate"
    },
    "businessActionId": {
      "$ref": "#/$defs/id"
    },
    "requestDigest": {
      "$ref": "#/$defs/digest"
    },
    "planDigest": {
      "$ref": "#/$defs/digest"
    },
    "beforeCandidateDigest": {
      "$ref": "#/$defs/digest"
    },
    "afterCandidateDigest": {
      "$ref": "#/$defs/digest"
    },
    "beforeGeneration": {
      "$ref": "#/$defs/positive"
    },
    "afterGeneration": {
      "$ref": "#/$defs/positive"
    },
    "rollbackOf": {
      "const": null
    },
    "executingActor": {
      "$ref": "#/$defs/id"
    },
    "authorityEpoch": {
      "$ref": "#/$defs/positive"
    },
    "committedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "committed": {
      "const": true
    },
    "authority": {
      "const": false
    },
    "qualification": {
      "const": false
    },
    "sourceCandidateDigest": {
      "$ref": "#/$defs/digest"
    },
    "verificationPlanDigest": {
      "$ref": "#/$defs/digest"
    },
    "verificationEvidenceDigest": {
      "$ref": "#/$defs/digest"
    },
    "decisionDigest": {
      "$ref": "#/$defs/digest"
    },
    "taskKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityDomain",
        "projectId",
        "changeId",
        "taskId"
      ],
      "properties": {
        "authorityDomain": {
          "$ref": "#/$defs/id"
        },
        "projectId": {
          "$ref": "#/$defs/id"
        },
        "changeId": {
          "$ref": "#/$defs/id"
        },
        "taskId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "taskRevision": {
      "$ref": "#/$defs/positive"
    },
    "taskCycle": {
      "$ref": "#/$defs/positive"
    },
    "policyDigest": {
      "$ref": "#/$defs/digest"
    },
    "toolDigest": {
      "$ref": "#/$defs/digest"
    },
    "obligationDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\u0000]+$"
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    }
  }
}
