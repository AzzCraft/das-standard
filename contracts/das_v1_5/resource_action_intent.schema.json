{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "das-resource-action-intent/v1",
  "title": "DAS immutable resource action intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractIdentity", "taskKey", "taskRevision", "taskCycle", "resourceId", "resourceInstance", "targetGeneration", "action", "businessActionId", "originalActor", "parameters", "toolDigest", "policyDigest", "budgetIds", "cost"],
  "properties": {
    "contractIdentity": {"const": "das-resource-action-intent/v1"},
    "taskKey": {
      "type": "object", "additionalProperties": false,
      "required": ["authorityDomain", "projectId", "changeId", "taskId"],
      "properties": {
        "authorityDomain": {"$ref": "#/$defs/id"}, "projectId": {"$ref": "#/$defs/id"},
        "changeId": {"$ref": "#/$defs/id"}, "taskId": {"$ref": "#/$defs/id"}
      }
    },
    "taskRevision": {"$ref": "#/$defs/positive"}, "taskCycle": {"$ref": "#/$defs/positive"},
    "resourceId": {"$ref": "#/$defs/id"}, "resourceInstance": {"$ref": "#/$defs/id"},
    "targetGeneration": {"$ref": "#/$defs/positive"},
    "action": {"enum": ["inspect", "plan", "apply", "submit", "integrate", "complete", "rollback", "audit"]},
    "businessActionId": {"$ref": "#/$defs/id"}, "originalActor": {"$ref": "#/$defs/id"},
    "parameters": {"type": "object", "maxProperties": 64},
    "toolDigest": {"$ref": "#/$defs/digest"}, "policyDigest": {"$ref": "#/$defs/digest"},
    "budgetIds": {"type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "cost": {"$ref": "#/$defs/positive"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000]+$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
