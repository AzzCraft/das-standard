{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "das-version-switch-receipt/v1",
  "title": "DAS staging native version reference receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["contractIdentity", "authorityDomain", "resourceId", "resourceInstance", "action", "businessActionId", "requestDigest", "planDigest", "beforeCandidateDigest", "afterCandidateDigest", "beforeGeneration", "afterGeneration", "rollbackOf", "executingActor", "authorityEpoch", "committedAt", "committed", "authority", "qualification"],
  "properties": {
    "contractIdentity": {"const": "das-version-switch-receipt/v1"},
    "authorityDomain": {"$ref": "#/$defs/id"}, "resourceId": {"$ref": "#/$defs/id"}, "resourceInstance": {"$ref": "#/$defs/id"},
    "action": {"enum": ["apply", "rollback"]}, "businessActionId": {"$ref": "#/$defs/id"},
    "requestDigest": {"$ref": "#/$defs/digest"}, "planDigest": {"$ref": "#/$defs/digest"},
    "beforeCandidateDigest": {"$ref": "#/$defs/digest"}, "afterCandidateDigest": {"$ref": "#/$defs/digest"},
    "beforeGeneration": {"$ref": "#/$defs/positive"}, "afterGeneration": {"$ref": "#/$defs/positive"},
    "rollbackOf": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "executingActor": {"$ref": "#/$defs/id"}, "authorityEpoch": {"$ref": "#/$defs/positive"},
    "committedAt": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "committed": {"const": true}, "authority": {"const": false}, "qualification": {"const": false}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000]+$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"}
  }
}
