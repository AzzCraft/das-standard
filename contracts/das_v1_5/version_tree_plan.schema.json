{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "das-version-tree-plan/v1",
  "title": "DAS protected version tree plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["contractIdentity", "taskKey", "taskRevision", "taskCycle", "resourceId", "resourceInstance", "expectedGeneration", "beforeCandidateDigest", "afterCandidateDigest", "policyDigest", "toolDigest", "rollbackOf", "changes"],
  "properties": {
    "contractIdentity": {"const": "das-version-tree-plan/v1"},
    "taskKey": {
      "type": "object", "additionalProperties": false,
      "required": ["authorityDomain", "projectId", "changeId", "taskId"],
      "properties": {
        "authorityDomain": {"$ref": "#/$defs/id"}, "projectId": {"$ref": "#/$defs/id"},
        "changeId": {"$ref": "#/$defs/id"}, "taskId": {"$ref": "#/$defs/id"}
      }
    },
    "taskRevision": {"$ref": "#/$defs/positive"}, "taskCycle": {"$ref": "#/$defs/positive"},
    "resourceId": {"$ref": "#/$defs/id"}, "resourceInstance": {"$ref": "#/$defs/id"},
    "expectedGeneration": {"$ref": "#/$defs/positive"},
    "beforeCandidateDigest": {"$ref": "#/$defs/digest"}, "afterCandidateDigest": {"$ref": "#/$defs/digest"},
    "policyDigest": {"$ref": "#/$defs/digest"}, "toolDigest": {"$ref": "#/$defs/digest"},
    "rollbackOf": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
    "changes": {
      "type": "array", "maxItems": 4224,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "owner", "originDigest", "preimage", "postimage", "deletionReason"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 256},
          "owner": {"$ref": "#/$defs/id"}, "originDigest": {"$ref": "#/$defs/digest"},
          "preimage": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/image"}]},
          "postimage": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/image"}]},
          "deletionReason": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256}]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000]+$"},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "size", "contentSha256"],
      "properties": {
        "mode": {"enum": ["100644", "100755", "data"]},
        "size": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "contentSha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
