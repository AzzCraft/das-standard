#!/usr/bin/env bash
# Compare SPECIFICATION.md and appendices only; not the entire Standard bundle.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
usage() { echo "Usage: $0 old [new] [--stat]" >&2; exit 2; }
[[ $# -ge 1 ]] || usage
OLD_REF="$1"
shift
NEW_REF=HEAD
STAT=()
if [[ $# -gt 0 && "$1" != --* ]]; then NEW_REF="$1"; shift; fi
if [[ $# -gt 0 && "$1" == --stat ]]; then STAT=(--stat); shift; fi
[[ $# -eq 0 && "$OLD_REF" != -* && "$NEW_REF" != -* ]] || usage
OLD_OID="$(git rev-parse --verify --end-of-options "$OLD_REF^{commit}")"
NEW_OID="$(git rev-parse --verify --end-of-options "$NEW_REF^{commit}")"
git diff "${STAT[@]}" "$OLD_OID" "$NEW_OID" -- SPECIFICATION.md appendices/
